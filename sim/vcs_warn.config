{+lint=all,noNS;}
{+warn=noDPI-SFESN;}
{+warn=noUII-L;}
{+warn=noMCFNF;}
{
    +lint=none;
    +file=/software/Synopsys-2024_x86_64/vcs/W-2024.09/etc/sva/rec_ltl_classes_package.svp;
}
{
    +lint=none;
    +file=../../hvl/common/rvfimon.v;
}
// CVW-derived core (hdl/core): width/length lint (CAWM-L, WMIA-L, ULCO) is waived
// by an entry the Makefile appends at build time, listing every hdl/core source --
// -msg_config has no file wildcards, and ULCO is reported before the hierarchy
// exists, so +tree cannot scope it.  This mirrors the WIDTHTRUNC/WIDTHEXPAND waiver
// for */hdl/core/* in verilator_warn.vlt; the wrapper and testbench stay fully checked.
// Unused inputs: same module list as the SpyGlass W240 waivers in lint/lint.awl
// (configuration/instance-dependent ports, bus-standard signals, test hooks).
{
    +lint=noUI;
    +module=cache,cacheway,controllerinput,ebu,fdivsqrtpostproc,fdivsqrtpreproc,specialcase,bitmanipalu,icpred,lsu,mdu,pmpadrdec,tlbcontrol,csrm,gpio_apb,plic_apb,rom_ahb,spi_apb,uart_apb,uncore,ft_fault_inject,rv64_core_wrapper;
}

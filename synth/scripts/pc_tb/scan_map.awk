# scan_map.awk -- scandef (DEF SCANCHAINS) -> scan_map.svh for tb_scan.sv.
#   awk [-v LOGICAL_PHASE=forte_top.scan_phase.txt] -f scan_map.awk forte_top.scandef > scan_map.svh
#
# LOGICAL_PHASE (optional) is the file dft_insert.tcl writes next to the
# scandef: "<scandef instance path> <0|1>" per line, # comments; 1 = the flop
# stores its RTL bit inverted.  It becomes map_ph.  A cell with no entry is 0.
# This is not the scan-output inversion ("( OUT QN )"), which is map_qn.
#
# For every chain cN (k = N+1 in the bench) and every cell j along it, j = 1
# next to scan-in: the PC bit it holds (from "pcreg...q_reg_<bit>_"; -1 for a
# cell that is not a PC flop) and whether its scan output is QN (map_qn 1/0;
# 2 if the scandef names no OUT pin, and the bench then works it out from the
# inversion it measures on the pin).  Cells are the FLOATING/ORDERED entries
# in file order.  START and STOP are endpoints, not cells: STOP is "PIN
# io_out[k]" or "<component> <input pin>" (the scan-out gate insert_dft puts in
# front of the pad), never a scan flop.

BEGIN {
    if (LOGICAL_PHASE != "") {
        while ((rc = (getline ln < LOGICAL_PHASE)) > 0) {
            sub(/#.*/, "", ln)
            if (ln ~ /^[[:space:]]*$/) continue
            nf = split(ln, f, /[[:space:]]+/)
            if (f[1] == "") { f[1] = f[2]; f[2] = f[3]; nf-- }
            if (nf != 2 || (f[2] != "0" && f[2] != "1")) {
                print "scan_map.awk: bad LOGICAL_PHASE line: " ln > "/dev/stderr"; bad = 1; continue
            }
            if ((f[1] in phase) && phase[f[1]] != f[2]) {
                print "scan_map.awk: conflicting LOGICAL_PHASE entries for " f[1] > "/dev/stderr"; bad = 1
            }
            phase[f[1]] = f[2]
            n_phase++
        }
        if (rc < 0) { print "scan_map.awk: cannot read LOGICAL_PHASE " LOGICAL_PHASE > "/dev/stderr"; exit 1 }
        close(LOGICAL_PHASE)
    }
}

function add_cell(name, qn,    s) {
    n++
    cell[k, n] = name
    inv[k, n] = qn
    ph[k, n] = (name in phase) ? phase[name] + 0 : 0
    if (name in phase) used[name] = 1
    if (ph[k, n]) n_ph1++
    bit[k, n] = -1
    if (name ~ /pcreg/ && match(name, /q_reg[_\[]*[0-9]+/)) {
        s = substr(name, RSTART, RLENGTH)
        gsub(/[^0-9]/, "", s)
        bit[k, n] = s + 0
    }
}

function end_chain() {
    if (k > 0) len[k] = n
    k = 0; n = 0; mode = ""
}

/^[[:space:]]*SCANCHAINS[[:space:]]/ { in_sc = 1; next }
/^[[:space:]]*END[[:space:]]+SCANCHAINS/ { end_chain(); in_sc = 0; next }

in_sc {
    line = $0
    gsub(/[();]/, " & ", line)
    nt = split(line, t, /[[:space:]]+/)
    for (i = 1; i <= nt; i++) {
        tok = t[i]
        if (tok == "") continue
        if (want == "name") {
            if (tok !~ /^c[0-9]+$/) { print "scan_map.awk: chain '" tok "' is not named cN" > "/dev/stderr"; bad = 1 }
            k = substr(tok, 2) + 1; n = 0; chains++
            want = ""; continue
        }
        if (want == "kw") { mode = tok; want = ""; continue }
        if (tok == "-") { end_chain(); want = "name"; continue }
        if (tok == "+") { want = "kw"; continue }
        if (tok == ";") { end_chain(); continue }
        if (tok == "(") { paren = 1; pdir = ""; continue }
        if (tok == ")") { paren = 0; continue }
        if (paren) {
            if (pdir == "") pdir = tok
            else if (pdir == "OUT" && n > 0) inv[k, n] = (tok ~ /N$/) ? 1 : 0
            continue
        }
        # STOP names where the chain ends: "PIN <port>" or "<component> <input
        # pin>" -- e.g. the scan-out gate insert_dft puts in front of io_out[k].
        # Never a scan cell, so it is not added.
        if (mode == "FLOATING" || mode == "ORDERED") add_cell(tok, 0)
    }
}

END {
    if (!chains) { print "scan_map.awk: no scan chains found" > "/dev/stderr"; exit 1 }
    if (bad) exit 1
    printf "// scan_map.svh -- generated by run.sh from %s; do not edit.\n", FILENAME
    print  "// Chain cN is k = N+1; cell j = 1 is next to scan-in.  map_bit: the PC bit"
    print  "// the cell holds, -1 if not a PC flop.  map_qn: 1 = scan output from QN,"
    print  "// 2 = no OUT pin in the scandef (the bench derives it from the pin)."
    print  "// map_ph: 1 = the flop stores its bit inverted (LOGICAL_PHASE " (LOGICAL_PHASE == "" ? "not given: all 0" : LOGICAL_PHASE) ")."
    print  "function automatic void scan_map_init();"
    for (kk = 1; kk <= 64; kk++) {
        if (!(kk in len)) continue
        printf "  map_len[%d] = %d;\n", kk, len[kk]
        for (j = 1; j <= len[kk]; j++)
            printf "  map_bit[%d][%d] = %d; map_qn[%d][%d] = %d; map_ph[%d][%d] = %d;  // %s\n", kk, j, bit[kk, j], kk, j, inv[kk, j], kk, j, ph[kk, j], cell[kk, j]
    }
    print  "endfunction"
    if (LOGICAL_PHASE != "") {
        for (c in phase) if (!(c in used)) n_unused++
        printf "scan_map.awk: LOGICAL_PHASE: %d entries, %d cells inverted, %d entries not in the scandef\n", n_phase, n_ph1 + 0, n_unused + 0 > "/dev/stderr"
    }
}

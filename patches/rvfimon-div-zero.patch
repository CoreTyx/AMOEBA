rvfimon.v: keep zero divisors away from the simulator's native divide

Follow-up to rvfimon-div-overflow.patch.  Every generated DIV/DIVU/REM/REMU
(and W) model evaluates `a / b` or `a % b` unconditionally and only afterwards
selects the RISC-V divide-by-zero result with a mux on `b == 0`.  The untaken
branch is still evaluated, so a zero divisor reaches VCS's native x86 divide,
which raised SIGFPE and killed the simulation (seen in FreeRTOS
tc_sorting_result at ~200k cycles; the run passes with ECE411_NO_RVFI).

The models are also evaluated on every cycle for every instruction, so the
operands can carry X bits (e.g. around reset), and a guard computed on an
intermediate net can lag the operands within a timestep.  Either way the host
divide can see a zero (or INT_MIN / -1) divisor.  So the guard and the divide
now live in one function, evaluated atomically on its own arguments: any X
operand, a zero divisor, or (signed) INT_MIN / -1 returns 0 instead of
dividing.  Every selected result is unchanged: those cases are answered by the
special-case mux, not by the divide.

Applied after rvfimon-div-overflow.patch by `make -C sim generated-files` and
verified by `make -C sim check-generated`.  Remove once riscv-formal guards
these divides upstream and the submodule has been bumped past it.

--- a/hvl/common/rvfimon.v
+++ b/hvl/common/rvfimon.v
@@ -14708,7 +14708,16 @@
   // AMOEBA local fix -- see patches/rvfimon-div-overflow.patch.  Divisor forced
   // to 1 for INT_MIN / -1, whose result comes from the special case below.
   wire signed [64-1:0] div_rs2_s = rvfi_rs1_rdata == {1'b1, {64-1{1'b0}}} && rvfi_rs2_rdata == {64{1'b1}} ? 64'sd1 : rvfi_rs2_rdata;
-  wire signed [64-1:0] div_result_s = div_rs1_s / div_rs2_s;
+  // AMOEBA local fix -- see patches/rvfimon-div-zero.patch.  Guard and divide in one
+  // function so the host divide never sees a stale, X-carrying, zero or INT_MIN/-1 operand.
+  function automatic signed [63:0] safe_s64_div;
+    input signed [63:0] a, b;
+    begin
+      if ($isunknown({a, b}) || b == 64'sd0 || (a == {1'b1, {63{1'b0}}} && b == -64'sd1)) safe_s64_div = 64'sd0;
+      else safe_s64_div = a / b;
+    end
+  endfunction
+  wire signed [64-1:0] div_result_s = safe_s64_div(div_rs1_s, rvfi_rs2_rdata);
   wire [64-1:0] result = rvfi_rs2_rdata == 64'b0 ? {64{1'b1}} :
                                          rvfi_rs1_rdata == {1'b1, {64-1{1'b0}}} && rvfi_rs2_rdata == {64{1'b1}} ? {1'b1, {64-1{1'b0}}} :
                                          div_result_s;
@@ -14762,8 +14771,16 @@
   wire misa_ok = 1;
 
   // DIVU instruction
+  // AMOEBA local fix -- see patches/rvfimon-div-zero.patch.
+  function automatic [63:0] safe_u64_div;
+    input [63:0] a, b;
+    begin
+      if ($isunknown({a, b}) || b == 64'd0) safe_u64_div = 64'd0;
+      else safe_u64_div = a / b;
+    end
+  endfunction
   wire [64-1:0] result = rvfi_rs2_rdata == 64'b0 ? {64{1'b1}} :
-                                         rvfi_rs1_rdata / rvfi_rs2_rdata;
+                                         safe_u64_div(rvfi_rs1_rdata, rvfi_rs2_rdata);
   assign spec_valid = rvfi_valid && !insn_padding && insn_funct7 == 7'b 0000001 && insn_funct3 == 3'b 101 && insn_opcode == 7'b 0110011;
   assign spec_rs1_addr = insn_rs1;
   assign spec_rs2_addr = insn_rs2;
@@ -14814,8 +14831,16 @@
   wire misa_ok = 1;
 
   // DIVUW instruction
+  // AMOEBA local fix -- see patches/rvfimon-div-zero.patch.
+  function automatic [31:0] safe_u32_div;
+    input [31:0] a, b;
+    begin
+      if ($isunknown({a, b}) || b == 32'd0) safe_u32_div = 32'd0;
+      else safe_u32_div = a / b;
+    end
+  endfunction
   wire [31:0] result = rvfi_rs2_rdata[31:0] == 32'b0 ? {32{1'b1}} :
-                       rvfi_rs1_rdata[31:0] / rvfi_rs2_rdata[31:0];
+                       safe_u32_div(rvfi_rs1_rdata[31:0], rvfi_rs2_rdata[31:0]);
   assign spec_valid = rvfi_valid && !insn_padding && insn_funct7 == 7'b 0000001 && insn_funct3 == 3'b 101 && insn_opcode == 7'b 0111011;
   assign spec_rs1_addr = insn_rs1;
   assign spec_rs2_addr = insn_rs2;
@@ -14870,7 +14895,16 @@
   // AMOEBA local fix -- see patches/rvfimon-div-overflow.patch.  Divisor forced
